# Machine-readable pins for every lab. Human-readable provenance is in VERSIONS.md.
# This file is both `source`-able from bash and `include`-able from make: keep it KEY=VALUE only.

# Flatcar
FLATCAR_CHANNEL=stable
FLATCAR_VERSION=4757.2.1
FLATCAR_OLD_VERSION=4593.2.5
FLATCAR_BOARD=amd64-usr
# Primary key fingerprint of the Flatcar image signing key, as embedded in flatcar-install
FLATCAR_SIGNING_KEY_FPR=F88CFEDEFF29A5B4D9523864E25D9AED0593B34A
# Where to read that embedded key from (pinned commit of flatcar/init)
FLATCAR_INSTALL_URL=https://raw.githubusercontent.com/flatcar/init/0765e955aca24034d66b9389e0d538e4c3ee543c/bin/flatcar-install

# Butane / Ignition
BUTANE_VERSION=0.29.0
BUTANE_SHA256=53a20d820fbaa7fda4f1afd1814974badc8e448db4c151d3f1ba005dc29bc4c9
BUTANE_VARIANT=flatcar
BUTANE_SPEC_VERSION=1.1.0

# Kubernetes the Hard Way on Flatcar (lab 04)
K8S_VERSION=v1.36.5
CNI_PLUGINS_VERSION=v1.9.1
# Used only by the native control-plane validation (make -C labs/04-kthw-on-flatcar native-test)
ETCD_VERSION=v3.6.14

# RKE2 (lab 05). Both are within Kubernetes 1.36.x.
RKE2_VERSION_START=v1.36.3+rke2r1
RKE2_VERSION_UPGRADE=v1.36.5+rke2r1
SUC_VERSION=v0.20.2

# Lab network (labs 04 and 05 use a host bridge; labs 01-03 use QEMU user networking)
LAB_BRIDGE=flcbr0
LAB_SUBNET=10.77.0.0/24
LAB_GATEWAY=10.77.0.1
LAB_DNS=1.1.1.1
